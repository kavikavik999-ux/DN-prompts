{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "User email address",
          "maxLength": 256
        },
        "displayName": {
          "type": "string",
          "description": "User display name",
          "maxLength": 100
        },
        "photoURL": {
          "type": "string",
          "description": "User profile avatar URL",
          "maxLength": 2048
        },
        "role": {
          "type": "string",
          "description": "Role of the user: user or admin",
          "enum": ["user", "admin"]
        },
        "createdAt": {
          "type": "string",
          "description": "Account creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "Profile update timestamp"
        }
      },
      "required": ["email", "displayName"]
    },
    "Prompt": {
      "title": "AI Image Prompt",
      "description": "AI prompt with image reference and metadata",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Prompt title",
          "maxLength": 150
        },
        "promptText": {
          "type": "string",
          "description": "The exact AI prompt text",
          "maxLength": 5000
        },
        "category": {
          "type": "string",
          "description": "Prompt category",
          "enum": [
            "Portrait",
            "Cinematic",
            "Couple",
            "Friendship",
            "Banners",
            "Love",
            "Stillout"
          ]
        },
        "imageUrl": {
          "type": "string",
          "description": "URL of the generated/uploaded image",
          "maxLength": 500000
        },
        "thumbnailUrl": {
          "type": "string",
          "description": "Thumbnail preview URL",
          "maxLength": 500000
        },
        "description": {
          "type": "string",
          "description": "Optional short description",
          "maxLength": 1000
        },
        "tags": {
          "type": "array",
          "description": "Array of keyword tags"
        },
        "instagramUrl": {
          "type": "string",
          "description": "Instagram link for the creator",
          "maxLength": 500
        },
        "youtubeUrl": {
          "type": "string",
          "description": "YouTube link for the creator",
          "maxLength": 500
        },
        "authorId": {
          "type": "string",
          "description": "Author UID",
          "maxLength": 128
        },
        "authorEmail": {
          "type": "string",
          "description": "Author email",
          "maxLength": 256
        },
        "likesCount": {
          "type": "number",
          "description": "Total likes count"
        },
        "savesCount": {
          "type": "number",
          "description": "Total saves count"
        },
        "viewsCount": {
          "type": "number",
          "description": "Total views count"
        },
        "usesCount": {
          "type": "number",
          "description": "Total prompt uses count"
        },
        "averageRating": {
          "type": "number",
          "description": "Average rating between 1 and 5"
        },
        "ratingCount": {
          "type": "number",
          "description": "Total number of ratings received"
        },
        "isDailyGenerated": {
          "type": "boolean",
          "description": "Whether this prompt was auto-generated daily"
        },
        "eventId": {
          "type": "string",
          "description": "Associated event ID if any",
          "maxLength": 128
        },
        "isFeatured": {
          "type": "boolean",
          "description": "Whether this is featured in carousel"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "Update timestamp"
        }
      },
      "required": ["title", "promptText", "category", "imageUrl"]
    },
    "Event": {
      "title": "DN Event",
      "description": "Gaming-style event schedule and theme",
      "type": "object",
      "properties": {
        "eventNumber": {
          "type": "number",
          "description": "Event slot number 1-24"
        },
        "name": {
          "type": "string",
          "description": "Event name",
          "maxLength": 100
        },
        "themeKey": {
          "type": "string",
          "description": "Visual theme identifier",
          "maxLength": 50
        },
        "description": {
          "type": "string",
          "description": "Event description",
          "maxLength": 500
        },
        "startDate": {
          "type": "string",
          "description": "Start timestamp ISO string"
        },
        "endDate": {
          "type": "string",
          "description": "End timestamp ISO string"
        },
        "status": {
          "type": "string",
          "description": "Current status",
          "enum": ["upcoming", "active", "completed"]
        },
        "colorScheme": {
          "type": "string",
          "description": "Color palette key",
          "maxLength": 50
        },
        "icon": {
          "type": "string",
          "description": "Icon identifier",
          "maxLength": 50
        },
        "promptIds": {
          "type": "array",
          "description": "Array of prompt IDs featured in this event"
        }
      },
      "required": ["eventNumber", "name", "startDate", "endDate", "status"]
    },
    "Like": {
      "title": "Prompt Like",
      "description": "Like record by user for a prompt",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "User UID",
          "maxLength": 128
        },
        "promptId": {
          "type": "string",
          "description": "Prompt Document ID",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "description": "Like timestamp"
        }
      },
      "required": ["userId", "promptId"]
    },
    "Save": {
      "title": "Prompt Save",
      "description": "Saved bookmark record by user",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "User UID",
          "maxLength": 128
        },
        "promptId": {
          "type": "string",
          "description": "Prompt Document ID",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "description": "Save timestamp"
        }
      },
      "required": ["userId", "promptId"]
    },
    "Rating": {
      "title": "Prompt Rating",
      "description": "Rating given by a user to a prompt",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "User UID",
          "maxLength": 128
        },
        "promptId": {
          "type": "string",
          "description": "Prompt Document ID",
          "maxLength": 128
        },
        "rating": {
          "type": "number",
          "description": "Numeric rating 1-5"
        },
        "createdAt": {
          "type": "string",
          "description": "Rating timestamp"
        }
      },
      "required": ["userId", "promptId", "rating"]
    },
    "Admin": {
      "title": "Admin Record",
      "description": "Authorized administrator record",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Admin email address",
          "maxLength": 256
        },
        "role": {
          "type": "string",
          "description": "admin",
          "enum": ["admin", "superadmin"]
        }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile collection"
    },
    "/prompts/{promptId}": {
      "schema": "Prompt",
      "description": "Main AI prompts collection"
    },
    "/events/{eventId}": {
      "schema": "Event",
      "description": "24 gaming-style event slots"
    },
    "/likes/{likeId}": {
      "schema": "Like",
      "description": "Per-user prompt likes"
    },
    "/saves/{saveId}": {
      "schema": "Save",
      "description": "Per-user prompt bookmarks"
    },
    "/ratings/{ratingId}": {
      "schema": "Rating",
      "description": "Per-user prompt ratings"
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Authorized admin users allowlist"
    }
  }
}
